[
  {
    "sid": "EBSDescribe",
    "effect": "Allow",
    "actions": [
      "ec2:DescribeAvailabilityZones",
      "ec2:DescribeInstances",
      "ec2:DescribeSnapshots",
      "ec2:DescribeTags",
      "ec2:DescribeVolumes",
      "ec2:DescribeVolumesModifications",
      "ec2:DescribeVolumeStatus"
    ],
    "resources": ["*"]
  },
  {
    "sid": "EBSCreateSnapshotAndModifyVolume",
    "effect": "Allow",
    "actions": [
      "ec2:CreateSnapshot",
      "ec2:ModifyVolume"
    ],
    "resources": ["arn:aws:ec2:*:*:volume/*"]
  },
  {
    "sid": "EBSCopyVolumes",
    "effect": "Allow",
    "actions": ["ec2:CopyVolumes"],
    "resources": ["arn:aws:ec2:*:*:volume/vol-*"]
  },
  {
    "sid": "EBSAttachDetach",
    "effect": "Allow",
    "actions": [
      "ec2:AttachVolume",
      "ec2:DetachVolume"
    ],
    "resources": [
      "arn:aws:ec2:*:*:volume/*",
      "arn:aws:ec2:*:*:instance/*"
    ]
  },
  {
    "sid": "EBSCreateVolumeFromSnapshot",
    "effect": "Allow",
    "actions": [
      "ec2:CreateVolume",
      "ec2:EnableFastSnapshotRestores"
    ],
    "resources": ["arn:aws:ec2:*:*:snapshot/*"]
  },
  {
    "sid": "EBSCreateTagsOnCreateAction",
    "effect": "Allow",
    "actions": ["ec2:CreateTags"],
    "resources": [
      "arn:aws:ec2:*:*:volume/*",
      "arn:aws:ec2:*:*:snapshot/*"
    ],
    "conditions": {
      "StringEquals": {
        "ec2:CreateAction": [
          "CreateVolume",
          "CreateSnapshot",
          "CopyVolumes"
        ]
      }
    }
  },
  {
    "sid": "EBSDeleteTags",
    "effect": "Allow",
    "actions": ["ec2:DeleteTags"],
    "resources": [
      "arn:aws:ec2:*:*:volume/*",
      "arn:aws:ec2:*:*:snapshot/*"
    ]
  },
  {
    "sid": "EBSCreateVolumeWithClusterTag",
    "effect": "Allow",
    "actions": [
      "ec2:CreateVolume",
      "ec2:CopyVolumes"
    ],
    "resources": ["arn:aws:ec2:*:*:volume/*"],
    "conditions": {
      "StringLike": {
        "aws:RequestTag/ebs.csi.aws.com/cluster": "true"
      }
    }
  },
  {
    "sid": "EBSCreateVolumeWithCSIName",
    "effect": "Allow",
    "actions": [
      "ec2:CreateVolume",
      "ec2:CopyVolumes"
    ],
    "resources": ["arn:aws:ec2:*:*:volume/*"],
    "conditions": {
      "StringLike": {
        "aws:RequestTag/CSIVolumeName": "*"
      }
    }
  },
  {
    "sid": "EBSDeleteVolumeByClusterTag",
    "effect": "Allow",
    "actions": ["ec2:DeleteVolume"],
    "resources": ["arn:aws:ec2:*:*:volume/*"],
    "conditions": {
      "StringLike": {
        "ec2:ResourceTag/ebs.csi.aws.com/cluster": "true"
      }
    }
  },
  {
    "sid": "EBSDeleteVolumeByCSIName",
    "effect": "Allow",
    "actions": ["ec2:DeleteVolume"],
    "resources": ["arn:aws:ec2:*:*:volume/*"],
    "conditions": {
      "StringLike": {
        "ec2:ResourceTag/CSIVolumeName": "*"
      }
    }
  },
  {
    "sid": "EBSDeleteVolumeByPVCTag",
    "effect": "Allow",
    "actions": ["ec2:DeleteVolume"],
    "resources": ["arn:aws:ec2:*:*:volume/*"],
    "conditions": {
      "StringLike": {
        "ec2:ResourceTag/kubernetes.io/created-for/pvc/name": "*"
      }
    }
  },
  {
    "sid": "EBSCreateSnapshotByCSIName",
    "effect": "Allow",
    "actions": ["ec2:CreateSnapshot"],
    "resources": ["arn:aws:ec2:*:*:snapshot/*"],
    "conditions": {
      "StringLike": {
        "aws:RequestTag/CSIVolumeSnapshotName": "*"
      }
    }
  },
  {
    "sid": "EBSCreateSnapshotByClusterTag",
    "effect": "Allow",
    "actions": ["ec2:CreateSnapshot"],
    "resources": ["arn:aws:ec2:*:*:snapshot/*"],
    "conditions": {
      "StringLike": {
        "aws:RequestTag/ebs.csi.aws.com/cluster": "true"
      }
    }
  },
  {
    "sid": "EBSDeleteSnapshotByCSIName",
    "effect": "Allow",
    "actions": [
      "ec2:DeleteSnapshot",
      "ec2:LockSnapshot"
    ],
    "resources": ["arn:aws:ec2:*:*:snapshot/*"],
    "conditions": {
      "StringLike": {
        "ec2:ResourceTag/CSIVolumeSnapshotName": "*"
      }
    }
  },
  {
    "sid": "EBSDeleteSnapshotByClusterTag",
    "effect": "Allow",
    "actions": [
      "ec2:DeleteSnapshot",
      "ec2:LockSnapshot"
    ],
    "resources": ["arn:aws:ec2:*:*:snapshot/*"],
    "conditions": {
      "StringLike": {
        "ec2:ResourceTag/ebs.csi.aws.com/cluster": "true"
      }
    }
  }
]
