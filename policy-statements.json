[
  {
    "sid": "ReadOnlyDescribeList",
    "effect": "Allow",
    "actions": [
      "rds:Describe*",
      "rds:List*",
      "elasticache:Describe*",
      "elasticache:List*",
      "elasticfilesystem:Describe*",
      "elasticfilesystem:List*",
      "eks:ListClusters",
      "secretsmanager:ListSecrets",
      "ec2:DescribeVpcs",
      "ec2:DescribeVpcAttribute",
      "ec2:DescribeSubnets",
      "ec2:DescribeSecurityGroups",
      "ec2:DescribeAvailabilityZones",
      "ec2:DescribeVpcEndpoints",
      "ec2:DescribeVpcEndpointServices",
      "ec2:DescribeRouteTables",
      "ec2:DescribeNetworkInterfaces",
      "ec2:DescribePrefixLists"
    ],
    "resources": ["*"]
  },
  {
    "sid": "RDSMutatingPavoResources",
    "scope": "runner",
    "effect": "Allow",
    "actions": ["rds:*"],
    "resources": [
      "arn:aws:rds:*:*:db:pavo-*",
      "arn:aws:rds:*:*:subgrp:pavo-*",
      "arn:aws:rds:*:*:snapshot:pavo-*"
    ]
  },
  {
    "sid": "ElastiCacheMutatingPavoResources",
    "scope": "runner",
    "effect": "Allow",
    "actions": ["elasticache:*"],
    "resources": [
      "arn:aws:elasticache:*:*:replicationgroup:pavo-*",
      "arn:aws:elasticache:*:*:subnetgroup:pavo-*",
      "arn:aws:elasticache:*:*:parametergroup:default.redis7"
    ]
  },
  {
    "sid": "S3",
    "effect": "Allow",
    "actions": ["s3:*"],
    "resources": [
      "arn:aws:s3:::pavo-*",
      "arn:aws:s3:::pavo-*/*"
    ]
  },
  {
    "sid": "DenyTerraformStateBucket",
    "comment": "The stage-1 state bucket (create-state-backend.sh default pavo-tf-state-<account>) matches the S3 grant above. Nothing Pavo-run reads it: stage 2 takes cell facts from SSM, never from remote state.",
    "effect": "Deny",
    "actions": ["s3:*"],
    "resources": [
      "arn:aws:s3:::pavo-tf-state-*",
      "arn:aws:s3:::pavo-tf-state-*/*"
    ]
  },
  {
    "sid": "SNS",
    "effect": "Allow",
    "actions": ["sns:*"],
    "resources": ["arn:aws:sns:*:*:pavo-*"]
  },
  {
    "sid": "SQS",
    "effect": "Allow",
    "actions": ["sqs:*"],
    "resources": ["arn:aws:sqs:*:*:pavo-*"]
  },
  {
    "sid": "SESCreateIdentityWithRequestTag",
    "effect": "Allow",
    "actions": ["ses:CreateEmailIdentity"],
    "resources": ["arn:aws:ses:*:*:identity/*"],
    "conditions": {
      "StringEquals": { "aws:RequestTag/managed_by": "pavo" }
    }
  },
  {
    "sid": "SESSendFromNoreply",
    "scope": "boundary",
    "effect": "Allow",
    "actions": ["ses:SendEmail"],
    "resources": ["arn:aws:ses:*:*:identity/*"],
    "conditions": {
      "StringLike": { "ses:FromAddress": "noreply@*" }
    }
  },
  {
    "sid": "SESMutatingTaggedPavoIdentities",
    "effect": "Allow",
    "actions": [
      "ses:DeleteEmailIdentity",
      "ses:GetEmailIdentity",
      "ses:ListTagsForResource",
      "ses:PutEmailIdentityDkimSigningAttributes"
    ],
    "resources": ["arn:aws:ses:*:*:identity/*"],
    "conditions": {
      "StringEquals": { "aws:ResourceTag/managed_by": "pavo" }
    }
  },
  {
    "sid": "SESTagWithoutRewritingOwnership",
    "effect": "Allow",
    "actions": ["ses:TagResource"],
    "resources": ["arn:aws:ses:*:*:identity/*"],
    "conditions": {
      "StringEquals": { "aws:ResourceTag/managed_by": "pavo" },
      "StringEqualsIfExists": { "aws:RequestTag/managed_by": "pavo" }
    }
  },
  {
    "sid": "SESUntagExceptOwnership",
    "effect": "Allow",
    "actions": ["ses:UntagResource"],
    "resources": ["arn:aws:ses:*:*:identity/*"],
    "conditions": {
      "StringEquals": { "aws:ResourceTag/managed_by": "pavo" },
      "ForAllValues:StringNotEquals": { "aws:TagKeys": ["managed_by"] }
    }
  },
  {
    "sid": "EFSCreateFileSystemWithRequestTag",
    "scope": "runner",
    "effect": "Allow",
    "actions": ["elasticfilesystem:CreateFileSystem"],
    "resources": ["*"],
    "conditions": {
      "StringEquals": {
        "aws:RequestTag/managed_by": "pavo"
      }
    }
  },
  {
    "sid": "EFSMutatingTaggedPavoResources",
    "scope": "runner",
    "effect": "Allow",
    "actions": ["elasticfilesystem:*"],
    "resources": ["*"],
    "conditions": {
      "StringEquals": {
        "aws:ResourceTag/managed_by": "pavo"
      }
    }
  },
  {
    "sid": "ACMRequestCertificateWithRequestTag",
    "scope": "runner",
    "effect": "Allow",
    "actions": ["acm:RequestCertificate"],
    "resources": ["*"],
    "conditions": {
      "StringEquals": {
        "aws:RequestTag/managed_by": "pavo"
      }
    }
  },
  {
    "sid": "ACMTaggedPavoCertificates",
    "scope": "runner",
    "effect": "Allow",
    "actions": [
      "acm:DescribeCertificate",
      "acm:GetCertificate",
      "acm:ListTagsForCertificate",
      "acm:AddTagsToCertificate",
      "acm:RemoveTagsFromCertificate",
      "acm:DeleteCertificate"
    ],
    "resources": ["arn:aws:acm:*:*:certificate/*"],
    "conditions": {
      "StringEquals": {
        "aws:ResourceTag/managed_by": "pavo"
      }
    }
  },
  {
    "sid": "EKSAccessAndDescribe",
    "scope": "runner",
    "effect": "Allow",
    "actions": [
      "eks:DescribeCluster",
      "eks:AccessKubernetesApi"
    ],
    "resources": [
      "arn:aws:eks:*:*:cluster/hc-*"
    ]
  },
  {
    "sid": "BedrockInvokeScopedToModels",
    "scope": "boundary",
    "effect": "Allow",
    "actions": [
      "bedrock:InvokeModel",
      "bedrock:InvokeModelWithResponseStream"
    ],
    "resources": [
      "arn:aws:bedrock:*::foundation-model/anthropic.claude-sonnet-4-6",
      "arn:aws:bedrock:*:*:inference-profile/us.anthropic.claude-sonnet-4-6",
      "arn:aws:bedrock:*::foundation-model/anthropic.claude-opus-4-6-v1",
      "arn:aws:bedrock:*:*:inference-profile/us.anthropic.claude-opus-4-6-v1",
      "arn:aws:bedrock:*::foundation-model/anthropic.claude-opus-5",
      "arn:aws:bedrock:*:*:inference-profile/us.anthropic.claude-opus-5",
      "arn:aws:bedrock:*::foundation-model/anthropic.claude-opus-5-5",
      "arn:aws:bedrock:*:*:inference-profile/us.anthropic.claude-opus-5-5",
      "arn:aws:bedrock:*::foundation-model/amazon.titan-embed-text-v2:0"
    ]
  },
  {
    "sid": "LambdaMicrovmsLifecycle",
    "scope": "boundary",
    "posture": "standard",
    "effect": "Allow",
    "actions": [
      "lambda:RunMicrovm",
      "lambda:GetMicrovm",
      "lambda:ListMicrovms",
      "lambda:SuspendMicrovm",
      "lambda:ResumeMicrovm",
      "lambda:TerminateMicrovm",
      "lambda:CreateMicrovmAuthToken",
      "lambda:GetMicrovmImage",
      "lambda:ListMicrovmImages",
      "lambda:ListMicrovmImageVersions"
    ],
    "resources": [
      "arn:aws:lambda:*:*:microvm*",
      "arn:aws:lambda:*:*:microvm-image*"
    ]
  },
  {
    "sid": "LambdaMicrovmsPassConnector",
    "comment": "Resource MUST be '*': RunMicrovm implicitly attaches the INTERNET_EGRESS network connector and the authorizer checks lambda:PassNetworkConnector against it, but rejects every resource-scoped form of that ARN (the implicit connector exposes no stable account-scoped ARN to name). Without this, RunMicrovm fails AccessDenied even when the lifecycle grants are correct. This is a ceiling, not a grant: it only caps what an identity policy may allow. The matching identity-policy statement in terraform-omnistrate-aws/main.tf is UNCONDITIONAL (gating it on the per-instance enable_lambda_microvms parameter revoked the grants during every deploy), so the effective permission of a workload role is decided here. posture=standard: a strict cell's boundary omits this and LambdaMicrovmsLifecycle, so MicroVMs (and their internet connector) are denied there regardless of identity grants. Accounts whose boundary predates these entries also cap those grants to nothing.",
    "scope": "boundary",
    "posture": "standard",
    "effect": "Allow",
    "actions": [
      "lambda:PassNetworkConnector"
    ],
    "resources": [
      "*"
    ]
  },
  {
    "sid": "ConnectorAssumeCustomerRoles",
    "scope": "boundary",
    "comment": "Ceiling for connectors that sign in by assuming a role in the customer's own account (Amazon SageMaker's IAM-role mode). It allows sts:AssumeRole only with a Pavo-issued external ID: the prefix pavo-, because the exact value is derived per tenant after the instance exists and cannot be named here. This is a ceiling, not a grant: the workload role's policy in terraform-omnistrate-aws/main.tf names the exact role ARNs from the cell parameter /pavo/cells/<cluster>/connector_assumable_role_arns (set through pavo-bootstrap-aws's connector_assumable_role_arns) and grants nothing while that is unset. The customer's role trust policy must also name the workload role and the exact external ID. Unlike the MicroVM ceilings above it has no posture filter, so every account bootstrapped from this version carries it.",
    "effect": "Allow",
    "actions": ["sts:AssumeRole"],
    "resources": ["arn:aws:iam::*:role/*"],
    "conditions": {
      "StringLike": {
        "sts:ExternalId": "pavo-*"
      }
    }
  },
  {
    "sid": "IAMScopedToPavoNames",
    "scope": "runner",
    "effect": "Allow",
    "actions": [
      "iam:GetRole",
      "iam:ListRoles",
      "iam:GetRolePolicy",
      "iam:ListAttachedRolePolicies",
      "iam:ListRolePolicies",
      "iam:ListInstanceProfilesForRole",
      "iam:ListRoleTags"
    ],
    "resources": [
      "arn:aws:iam::*:role/pavo-*",
      "arn:aws:iam::*:role/keda-*"
    ]
  },
  {
    "sid": "IAMWriteInstanceRoles",
    "scope": "runner",
    "comment": "Writes only on roles stage 2 created: it tags every role managed_by=pavo + instance=<id> in CreateRole (provider default_tags), so a customer role that happens to be named pavo-* (README example pavo-sagemaker-read) stays out of reach. TagRole is conditioned too, so the runner cannot tag a foreign role into scope.",
    "effect": "Allow",
    "actions": [
      "iam:DeleteRole",
      "iam:PassRole",
      "iam:PutRolePolicy",
      "iam:DeleteRolePolicy",
      "iam:AttachRolePolicy",
      "iam:DetachRolePolicy",
      "iam:TagRole",
      "iam:UntagRole",
      "iam:UpdateAssumeRolePolicy"
    ],
    "resources": [
      "arn:aws:iam::*:role/pavo-*",
      "arn:aws:iam::*:role/keda-*"
    ],
    "conditions": {
      "StringEquals": {
        "aws:ResourceTag/managed_by": "pavo"
      },
      "StringLike": {
        "aws:ResourceTag/instance": "instance-*"
      }
    }
  },
  {
    "sid": "IAMTagInstanceRolesAtCreate",
    "scope": "runner",
    "comment": "CreateRole with tags also authorises iam:TagRole, and IAM evaluates it before the role exists, so aws:ResourceTag is absent and IAMWriteInstanceRoles cannot match. Allow TagRole on the REQUEST tags instead, and only while the role carries neither ownership tag (Null on both aws:ResourceTag keys): that is the create path and an existing role nobody has tagged. A role tagged by another owner is out of reach here; a role stage 2 already owns is covered by IAMWriteInstanceRoles. Residual: an existing pavo-*/keda-* role with neither tag can be claimed. No aws:TagKeys list: it did not fit under the 10240-char runner-policy cap together with the Null conditions.",
    "effect": "Allow",
    "actions": [
      "iam:TagRole"
    ],
    "resources": [
      "arn:aws:iam::*:role/pavo-*",
      "arn:aws:iam::*:role/keda-*"
    ],
    "conditions": {
      "StringEquals": {
        "aws:RequestTag/managed_by": "pavo"
      },
      "StringLike": {
        "aws:RequestTag/instance": "instance-*"
      },
      "Null": {
        "aws:ResourceTag/managed_by": "true",
        "aws:ResourceTag/instance": "true"
      }
    }
  },
  {
    "sid": "IAMCreateRolesOnlyWithBoundary",
    "scope": "runner",
    "effect": "Allow",
    "actions": [
      "iam:CreateRole",
      "iam:PutRolePermissionsBoundary"
    ],
    "resources": [
      "arn:aws:iam::*:role/pavo-*",
      "arn:aws:iam::*:role/keda-*"
    ],
    "conditions": {
      "ArnLike": {
        "iam:PermissionsBoundary": "arn:aws:iam::*:policy/pavo-permission-boundary-*"
      }
    }
  },
  {
    "sid": "DenyCreateRoleWithoutBoundary",
    "effect": "Deny",
    "actions": ["iam:CreateRole"],
    "resources": [
      "arn:aws:iam::*:role/pavo-*",
      "arn:aws:iam::*:role/keda-*"
    ],
    "conditions": {
      "Null": {
        "iam:PermissionsBoundary": "true"
      }
    }
  },
  {
    "sid": "DenyDeleteRolePermissionsBoundary",
    "effect": "Deny",
    "actions": ["iam:DeleteRolePermissionsBoundary"],
    "resources": ["*"]
  },
  {
    "sid": "ServiceLinkedRoleCreate",
    "scope": "runner",
    "effect": "Allow",
    "actions": ["iam:CreateServiceLinkedRole"],
    "resources": [
      "arn:aws:iam::*:role/aws-service-role/rds.amazonaws.com/AWSServiceRoleForRDS",
      "arn:aws:iam::*:role/aws-service-role/elasticache.amazonaws.com/AWSServiceRoleForElastiCache*",
      "arn:aws:iam::*:role/aws-service-role/elasticfilesystem.amazonaws.com/*"
    ],
    "conditions": {
      "StringLike": {
        "iam:AWSServiceName": [
          "rds.amazonaws.com",
          "elasticache.amazonaws.com",
          "elasticfilesystem.amazonaws.com"
        ]
      }
    }
  },
  {
    "sid": "ServiceLinkedRolePolicyAttach",
    "scope": "runner",
    "effect": "Allow",
    "actions": [
      "iam:AttachRolePolicy",
      "iam:PutRolePolicy"
    ],
    "resources": [
      "arn:aws:iam::*:role/aws-service-role/rds.amazonaws.com/AWSServiceRoleForRDS",
      "arn:aws:iam::*:role/aws-service-role/elasticache.amazonaws.com/AWSServiceRoleForElastiCache*",
      "arn:aws:iam::*:role/aws-service-role/elasticfilesystem.amazonaws.com/*"
    ]
  },
  {
    "sid": "SSMRead",
    "effect": "Allow",
    "actions": [
      "ssm:GetParameter",
      "ssm:GetParameters",
      "ssm:GetParametersByPath"
    ],
    "resources": ["arn:aws:ssm:*:*:parameter/pavo/*"]
  },
  {
    "sid": "SecretsManagerCreateRDSSecret",
    "scope": "runner",
    "effect": "Allow",
    "actions": ["secretsmanager:CreateSecret"],
    "resources": ["*"],
    "conditions": {
      "StringLike": {
        "secretsmanager:Name": "rds!*"
      }
    }
  },
  {
    "sid": "SecretsManagerTagRDSSecret",
    "scope": "runner",
    "effect": "Allow",
    "actions": [
      "secretsmanager:TagResource",
      "secretsmanager:UntagResource"
    ],
    "resources": ["arn:aws:secretsmanager:*:*:secret:rds!*"]
  },
  {
    "sid": "SecretsManagerScopedRead",
    "scope": "boundary",
    "comment": "Ceiling for the per-instance ESO roles, which are identity-scoped to their own rds! secret. The runner never reads secret values (Terraform takes the ARN from DescribeDBInstances), so it is kept out of the runner policy.",
    "effect": "Allow",
    "actions": [
      "secretsmanager:GetSecretValue",
      "secretsmanager:DescribeSecret"
    ],
    "resources": ["arn:aws:secretsmanager:*:*:secret:rds!*"]
  },
  {
    "sid": "EC2CreateSecurityGroupWithRequestTag",
    "scope": "runner",
    "effect": "Allow",
    "actions": ["ec2:CreateSecurityGroup"],
    "resources": ["*"],
    "conditions": {
      "StringEquals": {
        "aws:RequestTag/managed_by": "pavo"
      },
      "StringLike": {
        "aws:RequestTag/instance": "instance-*"
      }
    }
  },
  {
    "sid": "EC2CreateSecurityGroupInVpc",
    "scope": "runner",
    "effect": "Allow",
    "actions": ["ec2:CreateSecurityGroup"],
    "resources": ["arn:aws:ec2:*:*:vpc/*"]
  },
  {
    "sid": "EC2CreateVpcEndpointWithRequestTag",
    "scope": "runner",
    "effect": "Allow",
    "actions": ["ec2:CreateVpcEndpoint"],
    "resources": ["arn:aws:ec2:*:*:vpc-endpoint/*"],
    "conditions": {
      "StringEquals": {
        "aws:RequestTag/managed_by": "pavo"
      },
      "StringLike": {
        "aws:RequestTag/instance": "instance-*"
      }
    }
  },
  {
    "sid": "EC2VpcEndpointSupportingResources",
    "scope": "runner",
    "effect": "Allow",
    "actions": [
      "ec2:CreateVpcEndpoint",
      "ec2:ModifyVpcEndpoint",
      "ec2:DeleteVpcEndpoints"
    ],
    "resources": [
      "arn:aws:ec2:*:*:vpc/*",
      "arn:aws:ec2:*:*:subnet/*",
      "arn:aws:ec2:*:*:route-table/*"
    ]
  },
  {
    "sid": "EC2VpcEndpointMutationsOnInstance",
    "scope": "runner",
    "effect": "Allow",
    "actions": [
      "ec2:ModifyVpcEndpoint",
      "ec2:DeleteVpcEndpoints"
    ],
    "resources": ["arn:aws:ec2:*:*:vpc-endpoint/*"],
    "conditions": {
      "StringEquals": {
        "aws:ResourceTag/managed_by": "pavo"
      },
      "StringLike": {
        "aws:ResourceTag/instance": "instance-*"
      }
    }
  },
  {
    "sid": "EC2NetworkInterfacesViaEFS",
    "scope": "runner",
    "effect": "Allow",
    "actions": [
      "ec2:CreateNetworkInterface",
      "ec2:DeleteNetworkInterface",
      "ec2:ModifyNetworkInterfaceAttribute"
    ],
    "resources": [
      "arn:aws:ec2:*:*:network-interface/*",
      "arn:aws:ec2:*:*:subnet/*"
    ],
    "conditions": {
      "StringEquals": {
        "aws:CalledViaLast": "elasticfilesystem.amazonaws.com"
      }
    }
  },
  {
    "sid": "DenyDirectENIWrites",
    "scope": "runner",
    "effect": "Deny",
    "actions": [
      "ec2:CreateNetworkInterface",
      "ec2:DeleteNetworkInterface",
      "ec2:ModifyNetworkInterfaceAttribute"
    ],
    "resources": ["*"],
    "conditions": {
      "StringNotEquals": {
        "aws:CalledViaLast": "elasticfilesystem.amazonaws.com"
      }
    }
  },
  {
    "sid": "EC2UseInstanceSecurityGroup",
    "scope": "runner",
    "effect": "Allow",
    "actions": [
      "ec2:CreateNetworkInterface",
      "ec2:ModifyNetworkInterfaceAttribute",
      "ec2:CreateVpcEndpoint",
      "ec2:ModifyVpcEndpoint"
    ],
    "resources": ["arn:aws:ec2:*:*:security-group/*"],
    "conditions": {
      "StringEquals": {
        "aws:ResourceTag/managed_by": "pavo"
      },
      "StringLike": {
        "aws:ResourceTag/instance": "instance-*"
      }
    }
  },
  {
    "sid": "EC2SecurityGroupMutationsTaggedPavo",
    "scope": "runner",
    "effect": "Allow",
    "actions": [
      "ec2:DeleteSecurityGroup",
      "ec2:AuthorizeSecurityGroupIngress",
      "ec2:RevokeSecurityGroupIngress",
      "ec2:AuthorizeSecurityGroupEgress",
      "ec2:RevokeSecurityGroupEgress"
    ],
    "resources": ["*"],
    "conditions": {
      "StringEquals": {
        "aws:ResourceTag/managed_by": "pavo"
      },
      "StringLike": {
        "aws:ResourceTag/instance": "instance-*"
      }
    }
  },
  {
    "sid": "EC2CreateTagsOnInstanceCreate",
    "scope": "runner",
    "effect": "Allow",
    "actions": ["ec2:CreateTags"],
    "resources": [
      "arn:aws:ec2:*:*:security-group/*",
      "arn:aws:ec2:*:*:vpc-endpoint/*"
    ],
    "conditions": {
      "StringEquals": {
        "ec2:CreateAction": ["CreateSecurityGroup", "CreateVpcEndpoint"],
        "aws:RequestTag/managed_by": "pavo"
      },
      "StringLike": {
        "aws:RequestTag/instance": "instance-*"
      }
    }
  },
  {
    "sid": "EC2TagWritesOnInstanceResources",
    "scope": "runner",
    "effect": "Allow",
    "actions": ["ec2:CreateTags"],
    "resources": [
      "arn:aws:ec2:*:*:security-group/*",
      "arn:aws:ec2:*:*:vpc-endpoint/*"
    ],
    "conditions": {
      "StringEquals": {
        "aws:ResourceTag/managed_by": "pavo"
      },
      "StringLike": {
        "aws:ResourceTag/instance": "instance-*"
      },
      "StringEqualsIfExists": {
        "aws:RequestTag/managed_by": "pavo",
        "aws:RequestTag/environment": "prod"
      },
      "StringLikeIfExists": {
        "aws:RequestTag/instance": "instance-*"
      }
    }
  },
  {
    "sid": "EC2UntagInstanceResourcesExceptOwnership",
    "scope": "runner",
    "effect": "Allow",
    "actions": ["ec2:DeleteTags"],
    "resources": [
      "arn:aws:ec2:*:*:security-group/*",
      "arn:aws:ec2:*:*:vpc-endpoint/*"
    ],
    "conditions": {
      "StringEquals": {
        "aws:ResourceTag/managed_by": "pavo"
      },
      "StringLike": {
        "aws:ResourceTag/instance": "instance-*"
      },
      "ForAllValues:StringNotEquals": {
        "aws:TagKeys": ["managed_by", "instance", "customer", "environment"]
      },
      "Null": {
        "aws:TagKeys": "false"
      }
    }
  },
  {
    "sid": "KMSUseOnCustomerKey",
    "scope": "boundary",
    "effect": "Allow",
    "actions": [
      "kms:DescribeKey",
      "kms:Decrypt",
      "kms:Encrypt",
      "kms:ReEncrypt*",
      "kms:GenerateDataKey",
      "kms:GenerateDataKeyWithoutPlaintext"
    ],
    "resources": ["*"],
    "conditions": {
      "StringLike": {
        "kms:ViaService": [
          "rds.*.amazonaws.com",
          "secretsmanager.*.amazonaws.com",
          "elasticache.*.amazonaws.com",
          "elasticfilesystem.*.amazonaws.com",
          "s3.*.amazonaws.com",
          "sns.*.amazonaws.com",
          "sqs.*.amazonaws.com"
        ]
      }
    }
  },
  {
    "sid": "KMSDescribeCustomerKeyDirect",
    "scope": "runner",
    "effect": "Allow",
    "actions": ["kms:DescribeKey"],
    "resources": ["arn:aws:kms:*:*:key/*"],
    "conditions": {
      "ForAnyValue:StringLike": {
        "kms:ResourceAliases": "alias/pavo-*"
      }
    }
  },
  {
    "sid": "KMSDescribeCustomerKeyByAlias",
    "scope": "runner",
    "effect": "Allow",
    "actions": ["kms:DescribeKey"],
    "resources": ["arn:aws:kms:*:*:alias/pavo-*"]
  },
  {
    "sid": "KMSGrantsForAWSResources",
    "scope": "runner",
    "effect": "Allow",
    "actions": [
      "kms:CreateGrant",
      "kms:ListGrants",
      "kms:RevokeGrant"
    ],
    "resources": ["arn:aws:kms:*:*:key/*"],
    "conditions": {
      "Bool": {
        "kms:GrantIsForAWSResource": "true"
      },
      "ForAnyValue:StringLike": {
        "kms:ResourceAliases": "alias/pavo-*"
      }
    }
  },
  {
    "sid": "KMSDescribeKeyViaRDS",
    "comment": "RDS create with manage_master_user_password describes aws/secretsmanager even when MasterUserSecretKmsKeyId is the cell CMK (AWS-documented). Metadata only.",
    "scope": "runner",
    "effect": "Allow",
    "actions": ["kms:DescribeKey"],
