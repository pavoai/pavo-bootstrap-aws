# prometheus-community/prometheus values — in-VPC, zero-egress metrics store.
#
# Invariants: NO remote_write OUT / CloudWatch / GMP -> metrics never leave the
# VPC. The remote-write *receiver* (--web.enable-remote-write-receiver) is an
# INBOUND, in-cluster path only (the OTel collector -> here), so zero-egress holds.
# scrapeConfigs is nulled to drop ALL built-in broad discovery; we add only the
# named jobs below (ES exporter + KSM + node-exporter + self).
#
# Templated by observability.tf: the Alertmanager route/receiver legs render only
# for the legs actually configured (${"$"}{customer_leg_enabled} / ${"$"}{pavo_leg_enabled});
# with neither set, every alert routes to the "null" receiver (no phantom POSTs).

server:
  retention: "15d"
  extraFlags:
    - web.enable-lifecycle
    - storage.tsdb.retention.size=15GB
    # Accept remote-write from the in-VPC OTel collector (app metrics). Inbound,
    # in-cluster only — no egress.
    - web.enable-remote-write-receiver
  global:
    scrape_interval: 30s
    evaluation_interval: 30s
  alertmanagers:
    - static_configs:
        - targets:
            - pavo-observability-prometheus-alertmanager:9093
  persistentVolume:
    enabled: true
    size: 20Gi
    storageClass: gp3-cmk
  resources:
    requests:
      cpu: 250m
      memory: 1Gi
    limits:
      cpu: "1"
      memory: 3Gi

alertmanager:
  enabled: true
  persistence:
    enabled: false
  config:
    route:
      receiver: "null"
      group_by: [alertname, severity]
      group_wait: 30s
      group_interval: 5m
      repeat_interval: 3h
%{ if customer_leg_enabled || pavo_leg_enabled ~}
      routes:
%{ if customer_leg_enabled ~}
        - receiver: customer
          continue: true
%{ endif ~}
%{ if pavo_leg_enabled ~}
        - receiver: pavo-sanitizer
          continue: false
%{ endif ~}
%{ endif ~}
    receivers:
      - name: "null"
%{ if customer_leg_enabled ~}
      - name: customer
        webhook_configs:
          - url_file: /etc/alertmanager/secrets/customer-alert-webhook/url
            send_resolved: true
%{ endif ~}
%{ if pavo_leg_enabled ~}
      - name: pavo-sanitizer
        webhook_configs:
          - url: http://pavo-alert-sanitizer.pavo-observability.svc:8080/alert
            send_resolved: true
%{ endif ~}
%{ if customer_leg_enabled ~}
  extraSecretMounts:
    - name: customer-alert-webhook
      secretName: customer-alert-webhook
      mountPath: /etc/alertmanager/secrets/customer-alert-webhook
      readOnly: true
%{ endif ~}

# Drop ALL chart built-in broad scrape jobs; we add named jobs in serverFiles.
scrapeConfigs: null

# Infra metrics: in-VPC KSM + node-exporter (scraped by the named jobs below).
kube-state-metrics:
  enabled: true
prometheus-node-exporter:
  enabled: true
prometheus-pushgateway:
  enabled: false

serverFiles:
  prometheus.yml:
    rule_files:
      - /etc/config/alerting_rules.yml
    scrape_configs:
      # App metrics (near-term) are SCRAPED from each app's /metrics endpoint by
      # the kubernetes-pods job below (prometheus.io/scrape annotations). The OTel
      # collector's remote-write path is also wired for the eventual move to OTLP
      # push, but scraping is the active app-metrics path today.
      #
      # ES exporter. Service-name-based (bootstrap is cell-scoped and does not
      # know the instance namespace); on a 1-instance strict cell only the
      # instance's pavo-es-exporter Service matches. keep on Service name + port.
      - job_name: pavo-es-exporter
        kubernetes_sd_configs:
          - role: endpoints
        relabel_configs:
          - source_labels: [__meta_kubernetes_service_name]
            action: keep
            regex: pavo-es-exporter
          - source_labels: [__meta_kubernetes_endpoint_port_name]
            action: keep
            regex: metrics
      # Infra: kube-state-metrics (pod/deployment/node object state).
      - job_name: kube-state-metrics
        kubernetes_sd_configs:
          - role: endpoints
            namespaces:
              names:
                - pavo-observability
        relabel_configs:
          - source_labels: [__meta_kubernetes_service_name]
            action: keep
            regex: pavo-observability-prometheus-kube-state-metrics
      # Infra: node-exporter (node CPU/mem/disk/network). DaemonSet -> per-pod.
      - job_name: node-exporter
        kubernetes_sd_configs:
          - role: endpoints
            namespaces:
              names:
                - pavo-observability
        relabel_configs:
          - source_labels: [__meta_kubernetes_service_name]
            action: keep
            regex: pavo-observability-prometheus-prometheus-node-exporter
      # Infra: cAdvisor (per-container CPU/mem/network/fs) via each node's kubelet.
      # Direct-kubelet scrape (https :10250 /metrics/cadvisor) — authorized by the
      # nodes/metrics RBAC the prometheus ClusterRole already grants (we do NOT have
      # nodes/proxy, so the apiserver-proxy variant is not used). This is what makes
      # the per-service resource dashboards universal (every pod, not just the ones
      # that expose a prometheus_client /metrics).
      - job_name: kubernetes-cadvisor
        scheme: https
        # Verify the kubelet's serving cert against the cluster CA — EKS signs it
        # and includes the node InternalIP in the SANs (confirmed on hc-fmnwao4ct),
        # so the bearer token is never sent to an unverified/impersonated endpoint.
        tls_config:
          ca_file: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt
        bearer_token_file: /var/run/secrets/kubernetes.io/serviceaccount/token
        kubernetes_sd_configs:
          - role: node
        relabel_configs:
          - action: labelmap
            regex: __meta_kubernetes_node_label_(.+)
          - source_labels: [__meta_kubernetes_node_name]
            target_label: node
          - target_label: __metrics_path__
            replacement: /metrics/cadvisor
      # Platform: Zitadel (self-hosted IdP). Serves OpenTelemetry Prometheus metrics
      # at https :8080 /debug/metrics (self-signed TLS, no auth). Service-name-based
      # like the ES exporter; on a cloud-Zitadel cell no Service matches and the job
      # is simply empty. Gives HTTP/gRPC RED + event-projection (CQRS) health.
      - job_name: zitadel
        scheme: https
        metrics_path: /debug/metrics
        # Zitadel serves a cert-manager self-signed cert (issuer zitadel-selfsigned)
        # minted per-instance; this cell-scoped Prometheus has no stable reference to
        # that instance CA, so it can't chain-verify. Accepted because the scrape
        # sends NO credentials (unauthenticated /debug/metrics) — the only exposure
        # is spoofed in-cluster metric data, not token theft. Revisit if Zitadel is
        # ever fronted by a cluster-trusted CA.
        tls_config:
          insecure_skip_verify: true
        kubernetes_sd_configs:
          - role: endpoints
        relabel_configs:
          - source_labels: [__meta_kubernetes_service_name]
            action: keep
            regex: zitadel
          - action: labelmap
            regex: __meta_kubernetes_pod_label_(.+)
          - source_labels: [__meta_kubernetes_namespace]
            target_label: namespace
          - source_labels: [__meta_kubernetes_pod_name]
            target_label: pod
      # App metrics (near-term). Every Pavo app service exposes a prometheus_client
      # /metrics endpoint; the SDK OTLP push path is not yet universal (only some
      # services emit it), so scrape /metrics from any pod that opts in via the
      # standard prometheus.io/scrape annotations. The OTel collector + remote-write
      # path stays wired for the eventual move to 100% OTel. Zero egress: scrape
      # traffic is in-cluster only.
      - job_name: kubernetes-pods
        kubernetes_sd_configs:
          - role: pod
        relabel_configs:
          - source_labels: [__meta_kubernetes_pod_annotation_prometheus_io_scrape]
            action: keep
            regex: "true"
          - source_labels: [__meta_kubernetes_pod_annotation_prometheus_io_path]
            action: replace
            target_label: __metrics_path__
            regex: (.+)
          - source_labels: [__address__, __meta_kubernetes_pod_annotation_prometheus_io_port]
            action: replace
            regex: ([^:]+)(?::\d+)?;(\d+)
            replacement: $1:$2
            target_label: __address__
          - action: labelmap
            regex: __meta_kubernetes_pod_label_(.+)
          - source_labels: [__meta_kubernetes_namespace]
            target_label: namespace
          - source_labels: [__meta_kubernetes_pod_name]
            target_label: pod
        metric_relabel_configs:
          # ingress-nginx edge metrics: keep RED (nginx_ingress_controller_requests +
          # _request_duration_seconds) but drop the request/response SIZE histograms.
          # Their series count is le × host × path × method × status — high cardinality
          # on a busy cell for little value. Targets only the ingress metric names.
          - source_labels: [__name__]
            regex: nginx_ingress_controller_(request_size|response_size)_(bucket|sum|count)
            action: drop
      - job_name: prometheus
        static_configs:
          - targets:
              - localhost:9090

  alerting_rules.yml:
    groups:
      - name: elasticsearch
        rules:
          - alert: ESClusterRed
            expr: elasticsearch_cluster_health_status{color="red"} == 1
            for: 2m
            labels:
              severity: critical
            annotations:
              summary: "ES cluster RED ({{ $labels.cluster }})"
          - alert: ESClusterYellow
            expr: elasticsearch_cluster_health_status{color="yellow"} == 1
            for: 15m
            labels:
              severity: warning
            annotations:
              summary: "ES cluster YELLOW ({{ $labels.cluster }})"
          - alert: ESUnassignedShards
            expr: elasticsearch_cluster_health_unassigned_shards > 0
            for: 10m
            labels:
              severity: warning
            annotations:
              summary: "ES has unassigned shards ({{ $labels.cluster }})"
          - alert: ESDiskFloodWatermark
            expr: (elasticsearch_filesystem_data_available_bytes / elasticsearch_filesystem_data_size_bytes) < 0.05
            for: 5m
            labels:
              severity: critical
            annotations:
              summary: "ES node <5% disk free ({{ $labels.name }} {{ $labels.path }})"
          - alert: ESExporterDown
            expr: absent(up{job="pavo-es-exporter"}) or max(up{job="pavo-es-exporter"}) < 1
            for: 5m
            labels:
              severity: warning
            annotations:
              summary: "Elasticsearch exporter not scrapeable"
      # Self-hosted Temporal (temporal_mode=self_hosted). Every rule is
      # presence-based (no absent()): on cells running Temporal Cloud these
      # series don't exist and the rules stay silent. All signals are
      # in-cluster scrapes — no CloudWatch/AWS API dependency; RDS trouble
      # surfaces via the persistence_* rules below.
      # SLO thresholds from the LLD: StartWorkflowExecution p95 < 150ms,
      # schedule-to-start p95 < 150ms, shard lock latency < 1ms.
      # Shard lock is the one alert that deliberately sits above its SLO: it
      # pages at 5ms, not 1ms. A healthy cell already measures ~0.99ms p99
      # under load, so alerting at the target would flap. 5ms = contention
      # worth waking someone for; use the dashboard panel to track the SLO.
      # Alertnames are mention-map keys in central-ci/variables.tf — rename both.
      - name: temporal
        rules:
          - alert: TemporalRoleUnavailable
            expr: kube_deployment_status_replicas_available{deployment=~"temporal-(frontend|history|matching|worker)"} == 0
            for: 5m
            labels:
              severity: critical
            annotations:
              summary: "Temporal {{ $labels.deployment }} has 0 available replicas"
          - alert: TemporalServiceErrorRateHigh
            expr: sum(rate(service_errors[5m])) / sum(rate(service_requests[5m])) > 0.05
            for: 10m
            labels:
              severity: warning
            annotations:
              summary: "Temporal service error ratio above 5%"
          - alert: TemporalStartWorkflowLatencySLO
            expr: histogram_quantile(0.95, sum by (le) (rate(service_latency_bucket{operation="StartWorkflowExecution"}[5m]))) > 0.15
            for: 15m
            labels:
              severity: warning
            annotations:
              summary: "StartWorkflowExecution p95 above the 150ms SLO"
          - alert: TemporalScheduleToStartLatencySLO
            # SDK histograms are in MILLISECONDS (Core SDK default, durations_as_seconds
            # unset in intern worker.py) — unlike the server metrics above (seconds).
            expr: histogram_quantile(0.95, sum by (le) (rate(temporal_workflow_task_schedule_to_start_latency_bucket[5m]))) > 150
            for: 15m
            labels:
              severity: warning
            annotations:
              summary: "Workflow task schedule-to-start p95 above the 150ms SLO (workers starving?)"
          - alert: TemporalShardLockLatencyHigh
            expr: histogram_quantile(0.99, sum by (le) (rate(lock_latency_bucket{operation="ShardInfo"}[5m]))) > 0.005
            for: 15m
            labels:
              severity: warning
            annotations:
              summary: "Shard lock latency p99 above 5ms — shard contention (too few shards?)"
          - alert: TemporalPersistenceErrors
            expr: sum(rate(persistence_errors[5m])) > 0
            for: 10m
            labels:
              severity: critical
            annotations:
              summary: "Temporal persistence errors — RDS trouble (connections/storage/timeouts)"
          - alert: TemporalResourceExhausted
            expr: sum(rate(service_errors_resource_exhausted[5m])) > 0
            for: 10m
            labels:
              severity: warning
            annotations:
              summary: "Temporal shedding load (resource_exhausted) — rps/concurrency limits hit"
          # Payload-size pair (LLD phase 9.3). increase() with no `for`: a single
          # rejection must fire; rate()>0 decays before a 5m hold completes.
          - alert: TemporalPayloadSizeRejections
            expr: sum(increase(blob_size_error[5m])) > 0
            labels:
              severity: critical
            annotations:
              summary: "Temporal rejecting payloads (blob or memo over the 2 MiB default limit) — workflows failing on payload size"
          - alert: TemporalBlobSizeApproachingLimit
            expr: histogram_quantile(0.95, sum by (le) (rate(event_blob_size_bucket[5m]))) > 1572864
            for: 15m
            labels:
              severity: warning
            annotations:
              summary: "Temporal p95 event blob size above 1.5 MiB — approaching the 2 MiB default rejection limit"
          # Blind spot closer: tasks on a queue nobody polls (worker pointed at a
          # wrong/renamed task queue) are invisible to every other metric —
          # schedule-to-start is SDK-side and only recorded on pickup.
          - alert: TemporalTaskQueueNoPollers
            expr: sum by (taskqueue) (increase(no_poller_tasks[10m])) > 0
            labels:
              severity: warning
            annotations:
              summary: "Temporal tasks arriving on task queue {{ $labels.taskqueue }} with no pollers — worker missing or polling a wrong queue name; workflows hang silently"
      # Workload health. Deliberately generic: these two rules watch every
      # Deployment and container in the scoped namespaces rather than naming
      # services, so a workload added later is covered without touching this
      # file. They are the backstop for the failure mode that cost us most of
      # 2026-08-28: config is wrong, the release still reports success, and the
      # damage only becomes visible when something recreates a Pod.
      #
      # Scope is the app instance namespaces PLUS pavo-observability. The
      # observability stack was previously the one thing the monitoring did not
      # monitor, which mattered once the bootstrap stopped blocking its apply on
      # pod readiness — without this, a Grafana or collector that fell over after
      # a converged cell went unreported.
      #
      # Both rules read kube-state-metrics (scraped by the job above).
      #
      # StatefulSets: covered for pavo-observability by a third rule below, NOT
      # for the instance namespaces. Elasticsearch is a StatefulSet with its own
      # health alerts in the group above, so widening the StatefulSet rule to the
      # instance namespaces would only double-alert on it.
      # (An earlier version of this comment claimed Elasticsearch was the only
      # StatefulSet on a cell. That stopped being true when the observability
      # stack landed, which added Postgres and Alertmanager.)
      #
      # LIMIT, read this before relying on these rules: they run INSIDE the stack
      # they watch. They cannot detect Prometheus failing to start, and if
      # kube-state-metrics is down the series vanish and the comparison below
      # silently stops firing rather than alerting. First-convergence assertion is
      # therefore NOT their job — that belongs to the Phase-4 readiness barrier,
      # which runs from outside the cell. These rules cover steady-state
      # degradation only.
      - name: workloads
        rules:
          # Fires whether the cause is a bad image, a failing probe, unschedulable
          # Pods, or a Pod that cannot start because its config is wrong. 15m is
          # long enough that an ordinary rolling update completes underneath it.
          - alert: DeploymentReplicasUnavailable
            expr: |
              sum by (namespace, deployment) (kube_deployment_status_replicas_available{namespace=~"instance-.*|pavo-observability"})
                < sum by (namespace, deployment) (kube_deployment_spec_replicas{namespace=~"instance-.*|pavo-observability"})
            for: 15m
            labels:
              severity: warning
            annotations:
              summary: "Deployment {{ $labels.namespace }}/{{ $labels.deployment }} has fewer available replicas than desired for 15m — bad config, failing probe, or unschedulable Pods"
          # Caught separately from the rule above because a Deployment can sit at
          # its desired replica count while extra Pods crash-loop behind it — an
          # HPA scale-up into a broken config looks healthy by replica count alone.
          # Init containers are included: both charts gate startup on one
          # (run-migrations, fix-permissions), and a Pod wedged there never
          # reaches its app container, so the non-init metric alone would miss it.
          - alert: ContainerCrashLooping
            expr: |
              sum by (namespace, pod, container) (
                kube_pod_container_status_waiting_reason{reason="CrashLoopBackOff", namespace=~"instance-.*|pavo-observability"}
                or kube_pod_init_container_status_waiting_reason{reason="CrashLoopBackOff", namespace=~"instance-.*|pavo-observability"}
              ) > 0
            for: 10m
            labels:
              severity: warning
            annotations:
              summary: "Container {{ $labels.namespace }}/{{ $labels.pod }}/{{ $labels.container }} is in CrashLoopBackOff — it cannot start with its current image or config"
          # StatefulSets, pavo-observability ONLY. Deliberately narrower than the
          # two rules above.
          #
          # The namespace holds two StatefulSets, and kube_deployment_* does not
          # see either: pavo-observability-postgres and
          # pavo-observability-prometheus-alertmanager (the Alertmanager chart
          # ships a StatefulSet, not a Deployment — verified on a live cell).
          #
          # Postgres alone would not justify this rule, since Grafana's
          # /api/health readiness probe returns 503 when it cannot reach its
          # database, so a Postgres outage already surfaces as Grafana replicas
          # unavailable. ALERTMANAGER is why this rule exists: nothing probes it
          # transitively, and when it is down alerts stop being DELIVERED while
          # everything else still looks healthy. That is the quietest possible
          # failure in an alerting stack.
          #
          # Scoped to pavo-observability rather than the instance namespaces so
          # this does not start double-alerting on Elasticsearch, which is a
          # StatefulSet with its own health rules in the group above.
          - alert: StatefulSetReplicasUnavailable
            expr: |
              sum by (namespace, statefulset) (kube_statefulset_status_replicas_ready{namespace="pavo-observability"})
                < sum by (namespace, statefulset) (kube_statefulset_replicas{namespace="pavo-observability"})
            for: 15m
            labels:
              severity: warning
            annotations:
              summary: "StatefulSet {{ $labels.namespace }}/{{ $labels.statefulset }} has fewer ready replicas than desired for 15m — if this is Alertmanager, alert delivery is down and other alerts will not reach anyone"
